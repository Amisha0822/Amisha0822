        "# First import everything\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "sns.set_style(\"whitegrid\")\n",
        "plt.rcParams['figure.figsize'] = (10, 5)\n",
        "\n",
        "\n",
        "# Separate numerical & categorical columns\n",
        "num_cols = train.select_dtypes(include=np.number).columns.tolist()\n",
        "cat_cols = train.select_dtypes(include='object').columns.tolist()\n",
        "\n",
        "# Remove target column\n",
        "if 'purchaseValue' in num_cols:\n",
        "    num_cols.remove('purchaseValue')\n",
        "\n",
        "\n",
        "# --------- Numerical plotting function ----------\n",
        "def plot_numerical_features(df, num_cols):\n",
        "    for col in num_cols:\n",
        "        plt.figure(figsize=(14, 5))\n",
        "\n",
        "        plt.subplot(1, 2, 1)\n",
        "        sns.histplot(df[col], kde=True, bins=30, color='skyblue')\n",
        "        plt.title(f'Distribution of {col}')\n",
        "\n",
        "        plt.subplot(1, 2, 2)\n",
        "        sns.boxplot(x=df[col], color='lightgreen')\n",
        "        plt.title(f'Boxplot of {col}')\n",
        "\n",
        "        plt.tight_layout()\n",
        "        plt.show()  # <-- this is important\n",
        "\n",
        "# Call the function here\n",
        "plot_numerical_features(train, num_cols)\n",
        "\n",
        "\n",
        "# --------- Categorical plotting function ----------\n",
        "def plot_categorical_features(df, cat_cols, top_n=10):\n",
        "    for col in cat_cols:\n",
        "        plt.figure(figsize=(10, 5))\n",
        "        vc = df[col].value_counts().head(top_n)\n",
        "        sns.barplot(x=vc.index, y=vc.values, palette='Set2')\n",
        "        plt.title(f'Top {top_n} categories in {col}')\n",
        "        plt.xticks(rotation=45)\n",
        "        plt.tight_layout()\n",
        "        plt.show()\n",
        "\n",
        "# Call the function here\n",
        "plot_categorical_features(train, cat_cols)\n"
